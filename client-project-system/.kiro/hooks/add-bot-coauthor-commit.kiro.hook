{
  "enabled": true,
  "name": "Add Bot Co-author to Commits",
  "description": "Ensures every git commit includes the agent bot as a co-author by appending the Co-authored-by trailer to the commit message",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "shell"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "If the command about to be executed is a `git commit`, ensure the commit message includes the following co-author trailer. Append it to the commit message using a blank line before it:\n\nCo-authored-by: Kiro Bot <f65df54eebd3046c49fc0f11ded6e1c88892afbb563723ea57c242169cf62a66+kiro-bot@users.noreply.github.com>\n\nThe commit message file (commit_msg.txt) must always be used to preserve proper newlines. The file content must follow this format:\n<subject line>\n\nCo-authored-by: Kiro Bot <f65df54eebd3046c49fc0f11ded6e1c88892afbb563723ea57c242169cf62a66+kiro-bot@users.noreply.github.com>\n\nIf the command is NOT a git commit, do nothing and proceed normally."
  }
}